[Unit]
Description=UNG-INTERNALNET Management API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ung-internalnet
EnvironmentFile=/etc/ung-internalnet.env
ExecStart=/opt/ung-internalnet/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
